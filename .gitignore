# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/.artifacts/
/.test-data

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files; only metadata and placeholders are public
.env*
!.env.example
!.env.schema

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
env.d.ts

# workflow local runtime
/.workflow
/.workflow-data
/.workflow-vitest
/.well-known/workflow
/.swc
