{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    ".next",
    ".test-data",
    "coverage",
    "drizzle",
    "node_modules",
    "playwright-report",
    "test-results",
    "bun.lock",
    "env.d.ts",
    "next-env.d.ts"
  ],
  "jsxSingleQuote": false,
  "printWidth": 88,
  "quoteProps": "as-needed",
  "semi": false,
  "singleAttributePerLine": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false
}
