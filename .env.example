NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:54329/nextjs_start
# Required: generate a unique value with `openssl rand -base64 48`; this placeholder is rejected.
BETTER_AUTH_SECRET=<generate-with-openssl-rand-base64-48>
BETTER_AUTH_URL=http://localhost:3000
# `development` writes local messages to .next/development-emails.
# Production must use `resend` with RESEND_API_KEY.
EMAIL_DELIVERY=development
EMAIL_FROM=Next.js Start <hello@example.test>
RESEND_API_KEY=
ALLOW_PREVIEW_PASSKEYS=false
