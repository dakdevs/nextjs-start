{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "checkers": ["typescript"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/domains/**/*.ts",
    "!src/domains/**/*.test.ts",
    "!src/domains/**/contracts/**"
  ],
  "reporters": ["clear-text", "progress"],
  "testRunner": "vitest",
  "thresholds": {
    "break": 70,
    "high": 85,
    "low": 70
  },
  "vitest": {
    "configFile": "vitest.config.ts"
  }
}
