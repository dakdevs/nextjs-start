# Varlock owns environment metadata. Values live in ignored files or Vercel.
# @defaultRequired=infer
# @defaultSensitive=inferFromPrefix(NEXT_PUBLIC_)
# @generateTsTypes(path=./env.d.ts)
# ---

# @optional @public @type=enum(development, test, production)
NODE_ENV=development

# Canonical origin, including protocol and without a trailing slash.
# @required @public @type=url
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pooled runtime database role. Production must encode required TLS in this URL.
# @required @sensitive @type=url
DATABASE_URL=

# Better Auth signing secret, generated independently per environment.
# @required @sensitive @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Must equal the canonical application origin for this environment.
# @required @public @type=url
BETTER_AUTH_URL=http://localhost:3000

# Select the local-only development mailbox or Resend in deployed environments.
# @required @public @type=enum(development, resend)
EMAIL_DELIVERY=development

# @required @public
EMAIL_FROM=Next.js Start <hello@example.test>

# @optional @sensitive
RESEND_API_KEY=

# Vercel-provided runtime metadata.
# @optional @public @auditIgnore
VERCEL_URL=
# @optional @public @auditIgnore @type=enum(production, preview, development)
VERCEL_ENV=
# @optional @public @auditIgnore
VERCEL_REGION=

# Disables passkey enrollment away from a stable canonical host.
# @optional @public
ALLOW_PREVIEW_PASSKEYS=false

# Set only by deterministic local/CI test orchestration.
# @optional @sensitive @auditIgnore
TEST_DATABASE_URL=
