{
  "name": "nextjs-start",
  "version": "0.1.0",
  "private": true,
  "description": "An agent-ready Next.js application starter for Vercel.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dakdevs/nextjs-start.git"
  },
  "type": "module",
  "scripts": {
    "dev": "varlock run -- bun run --bun next dev",
    "build": "varlock run -- bun run --bun next build",
    "start": "bun run --bun next start",
    "prepare": "bun tooling/quality/prepare-toolchain.ts",
    "ui:add": "shadcn add",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:config": "bun tooling/quality/assert-no-warning-severity.ts",
    "typecheck": "varlock run -- bun run --bun next typegen && tsc --noEmit && bun tooling/quality/check-effect-diagnostics.ts",
    "knip": "bun tooling/quality/run-knip.ts",
    "docs:check": "bun tooling/docs/validate.ts",
    "architecture:check": "bun tooling/architecture/validate.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "bun tooling/test/run-with-postgres.ts integration",
    "test:workflow": "bun tooling/test/run-with-postgres.ts workflow",
    "test:e2e": "bun tooling/test/run-with-postgres.ts e2e",
    "test:e2e:direct": "varlock run -- playwright test",
    "test:mutation": "stryker run",
    "db:generate": "varlock run -- drizzle-kit generate",
    "db:migrate": "varlock run -- drizzle-kit migrate",
    "db:studio": "varlock run -- drizzle-kit studio",
    "env:check": "varlock load",
    "env:audit": "varlock audit",
    "env:scan": "varlock scan",
    "verify": "bun tooling/verify.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@better-auth/drizzle-adapter": "1.7.2",
    "@better-auth/passkey": "1.7.2",
    "@mcp-b/webmcp-types": "5.1.0",
    "@orpc/client": "2.0.0-beta.32",
    "@orpc/contract": "2.0.0-beta.32",
    "@orpc/server": "2.0.0-beta.32",
    "@orpc/tanstack-query": "2.0.0-beta.32",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.102.8",
    "@varlock/nextjs-integration": "1.2.2",
    "@vercel/queue": "0.5.1",
    "better-auth": "1.7.2",
    "class-variance-authority": "0.7.1",
    "cn": "^0.2.5",
    "drizzle-orm": "0.45.2",
    "effect": "4.0.0-rc.112",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "nuqs": "2.10.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.26.0",
    "server-only": "0.0.1",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0",
    "usewebmcp": "5.1.0",
    "workflow": "4.8.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@dakdevs/oxlint-plugin": "github:dakdevs/oxlint-plugin#a044d4e997d4d895c1a642958d2c617ac7c4255c",
    "@effect/tsgo": "0.38.0",
    "@mcp-b/webmcp-polyfill": "5.1.0",
    "@playwright/test": "1.62.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@types/bun": "1.4.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@workflow/vitest": "4.0.21",
    "drizzle-kit": "0.31.10",
    "happy-dom": "20.8.1",
    "knip": "6.34.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "varlock": "1.18.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@1.2.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.0",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "@vercel/queue",
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
